# Koiné — configuration de production sur le NAS
#
# A copier en server/env.production, puis a remplir.
#
#   cp server/env.production.example server/env.production
#
# Ce fichier contient des secrets : il est dans le .gitignore et ne doit jamais
# etre versionne.

# ---------------------------------------------------------------------------
# Git
#
# Sur Synology, le paquet Git s'installe dans /usr/local/git, chemin absent
# des scripts non interactifs. Les scripts le retrouvent seuls, mais si le
# paquet a ete installe ailleurs, indiquez ici le chemin exact :
#   GIT_BIN=/volume1/@appstore/git/usr/bin/git
# ---------------------------------------------------------------------------
GIT_BIN=

# ---------------------------------------------------------------------------
# GitHub — l'image est construite en cloneant le depot
# ---------------------------------------------------------------------------
GITHUB_REPO=romainlegall/koine
GITHUB_BRANCH=main
# Jeton avec lecture seule sur le depot. Pour un depot prive :
#   https://github.com/settings/tokens  ->  Fine-grained token, lecture seule
# Si le depot est prive et le jeton vide, le clone echouera.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production

# Fuseau : sert aux horodatages de l'historique, affiches en temps relatif.
TZ=Europe/Paris

# ---------------------------------------------------------------------------
# Port
#
# Fixe dans docker-compose.yml : 3005 sur l'hote, 4100 dans le conteneur.
# 3000 (tresor-prive), 3002 (gestion_locative) et 3004 (plume) sont deja pris.
# ---------------------------------------------------------------------------